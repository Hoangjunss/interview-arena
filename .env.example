# Database configuration
DB_HOST=localhost
DB_NAME=interview_arena
DB_URL=jdbc:postgresql://localhost:5432/interview_arena
DB_USERNAME=interview_arena
DB_PASSWORD=interview_arena

# Cache & Message Queue
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT Security
JWT_SECRET=change-me-to-a-long-random-string-in-real-env
JWT_EXPIRATION_MINUTES=120

# AI Mock Interview (OpenAI or compatible API)
LLM_API_KEY=changeme
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Caddy Domain (Automatic HTTPS / local self-signed CA)
DOMAIN=localhost
ACME_EMAIL=admin@example.com

# PostgreSQL Backup sidecar settings
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_SECONDS=86400

# Judge0 Sandboxed Execution base URL
JUDGE0_BASE_URL=http://localhost:2358

# DSA Quotas
DSA_FREE_DAILY_QUOTA=20
DSA_MAX_SOURCE_LENGTH=20000

# Stripe Subscription Billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
STRIPE_SUCCESS_URL=http://localhost:5173/billing?checkout=success
STRIPE_CANCEL_URL=http://localhost:5173/billing?checkout=cancelled
